{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "env": {
        "APP_VARIANT": "development"
      },
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "beta": {
      "extends": "production",
      "channel": "beta",
      "env": {
        "APP_VERSION_OVERRIDE": "1.1.0"
      }
    },
    "release": {
      "extends": "production",
      "env": {
        "APP_VERSION_OVERRIDE": "1.1.0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6825671804",
        "appleTeamId": "3498G5A326"
      },
      "android": {
        "serviceAccountKeyPath": "REPLACE_PATH_TO_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON",
        "track": "internal"
      }
    }
  }
}
