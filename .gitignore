# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (Firebase 키·Microsoft 클라이언트 ID — 절대 커밋 금지)
.env
.env*.local

# Firebase Admin SDK 서비스 계정 키 (절대 커밋 금지 — 유출 시 DB 전체 권한 탈취됨)
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json
scripts/keys/
scripts/**/serviceAccount*.json

# 크롤러 출력 (대용량 데이터 — 커밋 제외)
scripts/output/
scripts/node_modules/
# 便覧 PDF 보관함(저작권·용량) — DATA-MANUAL §4. URL만 JSON _meta에 남긴다
docs/binran/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase CLI 배포 캐시
.firebase/

# 로컬 전용 Claude 설정
.claude/settings.local.json

# 테스트·시딩용 투고 원문(로컬 전용) — CONTENT-OPS §9-3
# 이 저장소는 public이다. 투고 원문을 커밋하면 앱에 올라간 글과 문자열이
# 1:1로 대조돼 「비표시로 올린다」(§3)는 결정이 무너진다. 공유는 비공개 경로로.
docs/test-content/

# Firestore 백업 덤프 (docs/BACKUP.md) — 이메일·쪽지 본문·초대 토큰이 평문으로 들어 있다.
# 기본 출력 경로는 저장소 밖이지만, --out 을 잘못 줘서 안에 떨어뜨렸을 때의 안전망.
ichi-backup/
*.jsonl

# 카드뉴스 그림 슬롯용 사진 (준희가 찍은 캠퍼스 사진 등) — 공개 저장소라 커밋하지 않는다.
# 원본은 Canva 라이브러리와 로컬에만 둔다. assets/README.md 참조
scripts/cardnews/assets/*.jpg
scripts/cardnews/assets/*.jpeg
scripts/cardnews/assets/*.png
scripts/cardnews/assets/*.webp
scripts/cardnews/assets/*.heic

# Cloud Functions（functions/）
functions/node_modules/
functions/.secret.local
functions/.env.local
