# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (Firebase 키·Microsoft 클라이언트 ID — 절대 커밋 금지)
.env
.env*.local

# Firebase Admin SDK 서비스 계정 키 (절대 커밋 금지 — 유출 시 DB 전체 권한 탈취됨)
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json
scripts/keys/
scripts/**/serviceAccount*.json

# 크롤러 출력 (대용량 데이터 — 커밋 제외)
scripts/output/
scripts/node_modules/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
