rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザープロフィール（ニックネーム・プロフィール写真・友達リスト）
    // 本人のみ読み書き可能。パスワードはここに保存しない（Firebase Authが管理）。
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 掲示板（学校ごとに分離、ログイン済みユーザーのみ）
    match /schools/{schoolDomain}/boards/{boardId}/posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.authorUid == request.auth.uid;
      }
    }
  }
}
