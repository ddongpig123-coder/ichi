rules_version = '2';

// ============================================================
// ichi Firestore セキュリティルール（拡張版）
//
// 【設計方針】
// - 条件はヘルパー関数に集約し、フェーズ移行時は関数定義のみ変更する。
//   例）成長期に「書き込みは認証ユーザーのみ」へ切り替える場合、
//       canWriteContent() を isSignedIn() && !isAnonymous() に変えるだけ。
// - まだ実装されていないコレクション（courses / reviews / reports /
//   friendRequests / friendships / timetables / lounges）のルールを
//   先行定義しておく。存在しないコレクションへのルールは無害。
// - verified昇格・friendship作成などクライアントに任せると偽装可能な
//   操作は、将来Cloud Functions（Admin SDK）に移す前提でTODOを明記。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── ヘルパー ──────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAnonymous() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // コンテンツ書き込み権限（フェーズ移行スイッチ）
    // 初期    : isSignedIn()                    ← 匿名ゲストも書き込み可
    // 成長期  : isSignedIn() && !isAnonymous()  ← 書き込みのみ認証必須
    function canWriteContent() {
      return isSignedIn();
    }

    // 投稿者本人確認（作成時）
    function isAuthor() {
      return request.resource.data.authorUid == request.auth.uid;
    }

    // 学校所属の確認（1.1 / docs/BOARD-ACCESS.md §3）
    // 学校掲示板は「読みは全員・書きはその学校を選んだ人だけ」。
    // ゲートはログイン有無ではなく users.schoolDomain の一致で張る
    // （匿名認証が常に発行されるので isSignedIn() は常に真になるため）。
    // ・users ドキュメントは AuthContext の ensureUserProfile が必ず作る。
    //   それでも無ければ get() がエラー＝拒否になる（fail closed で正しい）。
    // ・schoolDomain が null（「その他」＝未選択）の人はどの学校掲示板にも書けない。
    //   その人たちの行き先は森（lounges）。画面側で「学校を選択」導線を出す。
    // ・get() はリクエストあたり読み取り1回の課金（§3-5）。usersPublic でも同コスト。
    // 🔑 1.2 で学校メール認証を入れるときは、ここに
    //    && ...data.verificationLevel >= 1 を足すだけでよい（再設計が起きない）。
    function belongsToSchool(schoolDomain) {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.schoolDomain == schoolDomain;
    }

    // ── ユーザープロフィール ─────────────────────────────
    // 本人のみ読み書き可能。パスワードはここに保存しない（Firebase Authが管理）。
    // verificationLevel はクライアントから変更不可（自己昇格の防止）。
    // 昇格はCloud Functions（Microsoft学校アカウント検証後）のみが行う。
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && (!('verificationLevel' in request.resource.data)
            || request.resource.data.verificationLevel == 0);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(['verificationLevel']);
      allow delete: if isOwner(uid);

      // 学期別時間割（先輩時間割公開機能・Phase 2）
      // visibility: "private" | "friends" | "department" | "public"
      match /timetables/{semesterId} {
        // resource == null: その学期の時間割が未作成。友達には「空の時間割」として
        // 見せたいので読み取り(null取得)を許可する（非公開設定との区別のため）。
        allow read: if isOwner(uid)
          || (isSignedIn() && resource == null && isFriendOf(uid))
          || (isSignedIn() && resource != null && resource.data.visibility == 'public')
          || (isSignedIn() && resource != null && resource.data.visibility == 'friends'
              && isFriendOf(uid))
          || (isSignedIn() && resource != null && resource.data.visibility == 'department'
              && sameDepartment(uid));
        allow write: if isOwner(uid);
      }

      // ブロックリスト（本人のみ。相手には見えない）
      match /blocks/{blockedUid} {
        allow read, write: if isOwner(uid);
      }
    }

    // 友達判定：friendships/{小さいuid_大きいuid} の存在で判定
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function isFriendOf(uid) {
      return exists(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid)));
    }

    // 同一学部判定（読み取り2回発生に注意）
    function sameDepartment(uid) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department
          == get(/databases/$(database)/documents/users/$(uid)).data.department;
    }

    // ── 公開プロフィール（友達検索・表示用の最小情報ミラー） ──
    // users/{uid} 本体は本人のみ読めるため、他ユーザーに見せてよい情報
    // （ニックネーム・写真・学校・学部）だけをここに複製する。
    // GPA等の学業情報は絶対にここへ書かないこと。
    match /usersPublic/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && request.resource.data.uid == uid;
      allow delete: if isOwner(uid);
    }

    // ── メール→uid 索引（メールアドレスによる友達検索用） ──
    // 登録はAuthトークンのemailと一致する場合のみ = メール所有者本人だけが
    // 自分の索引を作れる（他人のメールを自分のuidに向ける偽装は不可能）。
    // ドキュメントIDは小文字メールアドレス。
    match /emailIndex/{email} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email == email;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ── 友達申請 ─────────────────────────────────────────
    // { fromUid, toUid, status: "pending"|"accepted"|"rejected", createdAt }
    match /friendRequests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      allow create: if canWriteContent()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';
      // 状態変更（承認/拒否）は受信者のみ。statusフィールド以外は変更不可。
      allow update: if isSignedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['status']);
      allow delete: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
    }

    // ── 友達関係（確定済み） ──────────────────────────────
    // ドキュメントID: pairId(uid1, uid2)。participants: [uid1, uid2]
    // TODO(server): 作成はCloud Functionsに移し、accepted済みの
    // friendRequestが存在する場合のみ許可するのが理想。
    match /friendships/{pairDocId} {
      // resource == null は「まだ友達でない」確認のためのget（存在チェック）を許可
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && pairDocId == pairId(request.resource.data.participants[0],
                               request.resource.data.participants[1]);
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.participants;
    }

    // ── 通報（アプリ審査要件・匿名性維持の前提） ─────────
    // 書き込み専用。他ユーザーの通報履歴は誰にも読ませない。
    // 閲覧・処理は運営（コンソール / Admin SDK）のみ。
    match /reports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── お問い合わせ（アプリ内フォーム。運営がコンソール/Admin SDKで確認） ──
    // 書き込み専用。本人の uid のみ作成可。閲覧・更新・削除はクライアント不可。
    match /inquiries/{inquiryId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── 講義マスターデータ（シラバス由来 + クラウドソーシング） ──
    // 公式クロールデータはAdmin SDKで投入（ルールを経由しない）。
    // クライアントからの登録は未検証（verified: false）のみ許可。
    // verified: true への昇格はCloud Functionsのみ（自作自演の防止）。
    match /schools/{schoolDomain}/departments/{deptId}/courses/{courseId} {
      allow read: if isSignedIn();
      allow create: if canWriteContent()
        && request.resource.data.verified == false
        && request.resource.data.addedBy == request.auth.uid;
      allow update, delete: if false;

      // クラウドソーシング確認（ユーザー登録講義の実在確認）。
      // ドキュメントID = uid で「1人1回」を構造強制。create/delete のみで
      // courses 本体を update せずに済むため、Blaze(Cloud Functions)不要で
      // 自作自演を防げる。confirms の件数が閾値以上ならクライアントが verified 相当と判定。
      match /confirms/{uid} {
        allow read: if isSignedIn();
        allow create: if canWriteContent()
          && request.auth.uid == uid
          && request.resource.data.uid == uid;
        allow delete: if isOwner(uid);
        allow update: if false;
      }

      // 講義レビュー（Phase 2）
      // ドキュメントID = 投稿者uid（1人1講義1レビューを構造で強制）
      // 構造化評価（rating 1〜5）+ 自由テキスト（言語別）
      match /reviews/{reviewerUid} {
        allow read: if isSignedIn();
        allow create: if canWriteContent()
          && request.auth.uid == reviewerUid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow update: if isOwner(reviewerUid)
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow delete: if isOwner(reviewerUid);
      }
    }

    // ── 掲示板共通ルール（学校掲示板・留学生ラウンジで共用） ──
    // posts / comments / likes の権限パターンを関数化。
    function canUpdatePost() {
      return isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        // いいね数・コメント数・閲覧数のカウンター更新は他ユーザー操作でも発生
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) ||
        // 閲覧数は「ちょうど+1」のみ許可する。affectedKeys だけ見ると任意の値に
        // 書き換えられる（水増し・0埋め）ため。既存文書は viewCount 欠落なので get で既定0。
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']) &&
          request.resource.data.viewCount is int &&
          request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1
        )
      );
    }

    // コメント更新権限：本人（ソフトデリート＝deleted等）または
    // likeCount のカウンター更新のみ（他ユーザーのいいねで発生）。
    function canUpdateComment() {
      return isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
      );
    }

    match /schools/{schoolDomain} {

      // 学校掲示板（学校ごとに分離）
      // 読み取りは全員に開放（コールドスタート優先。他校を覗けること自体が動機になる）。
      // 書き込みだけ所属を見る。締めるときは read 側に belongsToSchool を足せばよい
      // ＝スイッチは残してある（BOARD-ACCESS §3-3）。
      // いいね（likes / likeCount）は所属を見ない：読めるのに押せないと壊れて見えるため。
      match /boards/{boardId}/posts/{postId} {
        allow read: if isSignedIn();
        allow create: if canWriteContent() && isAuthor() && belongsToSchool(schoolDomain);
        allow update: if canUpdatePost();
        // 物理削除は禁止（MODERATION.md §1）: 削除は deleted:true フラグ(=update)で行い、
        // authorUid 等の記録を残す。ハード削除を許すと法的対応の証跡が消えるため。
        allow delete: if false;

        match /comments/{commentId} {
          allow read: if isSignedIn();
          // 대댓글도同じcomments配下（parentIdフィールドで区別、1階層）。
          allow create: if canWriteContent() && isAuthor() && belongsToSchool(schoolDomain);
          allow update: if canUpdateComment();
          allow delete: if false; // 物理削除禁止（上と同じ理由）

          // コメント/返信のいいね（ドキュメントID=uid、本人のみ）
          match /likes/{likeUid} {
            allow read: if isSignedIn();
            allow write: if isSignedIn() && request.auth.uid == likeUid;
          }
        }

        // いいね（ドキュメントIDはユーザーのuid）。本人のみ作成・削除可能。
        match /likes/{likeUid} {
          allow read: if isSignedIn();
          allow write: if isSignedIn() && request.auth.uid == likeUid;
        }
      }

      // 学部別・カスタム掲示板のメタ情報
      match /boardMetas/{boardMetaId} {
        allow read: if isSignedIn();
        allow create: if canWriteContent()
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isSignedIn()
          && resource.data.createdBy == request.auth.uid;
      }

      // ⚠️ DEPRECATED（1.1 で /chats 最上位へ移設。下の「全国チャット」を見ること）
      // 学校スコープだったため、森から他校ユーザーに送ったメッセージが
      // 相手に届かなかった（送信者の学校の下に部屋ができ、受信者は自分の学校の下だけを
      // 購読していた）。アプリは新パスしか書かない。
      // ここは移行スクリプト（scripts/migrate-chats-to-global.mjs）完了までの
      // 読み取り互換のために残す。新規作成は塞いである。
      // 移行確認後にこのブロックごと削除する。
      match /chats/{chatId} {
        allow read: if isSignedIn()
          && (resource == null || request.auth.uid in resource.data.participants);
        allow create: if false; // 移設済み。新パスへ書く
        allow update: if false;

        match /messages/{messageId} {
          allow read: if isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/schools/$(schoolDomain)/chats/$(chatId)).data.participants;
          allow create: if false;
        }
      }
    }

    // ── 個別チャット（メッセージ。全国スコープ・1.1） ──────
    // 学校の下から最上位へ移した。理由は上の DEPRECATED ブロックのコメント参照。
    // 権限は参加者（participants）ベースなので学校とは無関係に成立する。
    // schoolDomain を見ないので、学校未選択（その他）のユーザーもメッセージを使える。
    match /chats/{chatId} {
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow delete: if false; // 物理削除禁止（MODERATION.md §1）

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false; // 送信済みメッセージは改変・物理削除不可
      }
    }

    // ── 留学生ラウンジ（全国単位の掲示板・Phase 1） ────────
    // 学校掲示板と同じ権限パターン。学校選択のみで参加可能（低い参入障壁）。
    match /lounges/{loungeId}/posts/{postId} {
      allow read: if isSignedIn();
      allow create: if canWriteContent() && isAuthor();
      allow update: if canUpdatePost();
      allow delete: if false; // 物理削除禁止（MODERATION.md §1、学校掲示板と同じ）

      match /comments/{commentId} {
        allow read: if isSignedIn();
        // 대댓글도同じcomments配下（parentIdフィールドで区別、1階層）。
        allow create: if canWriteContent() && isAuthor();
        allow update: if canUpdateComment();
        allow delete: if false; // 物理削除禁止

        // コメント/返信のいいね（ドキュメントID=uid、本人のみ）
        match /likes/{likeUid} {
          allow read: if isSignedIn();
          allow write: if isSignedIn() && request.auth.uid == likeUid;
        }
      }

      match /likes/{likeUid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == likeUid;
      }
    }

    // ── 運営アカウント名簿（コンテンツ自動投稿・CONTENT-OPS §9） ──
    // 登録・削除は Firebase コンソールのみ（クライアントからの自己登録を防ぐ）。
    // 本人は「自分が運営か」だけ確認できる（承認画面の表示判定用）。一覧は誰にも見せない。
    match /operators/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow write: if false;
    }

    function isOperator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/operators/$(request.auth.uid));
    }

    // src/types/contentQueue.ts の ContentQueueItem と1:1（postedAt / postedPath は投稿後の付記なので検証しない）
    function isValidQueueItem(d) {
      return d.status in ['draft', 'approved', 'rejected', 'posted']
        && d.source in ['manual', 'ai']
        && ((d.scope == 'school' && d.schoolDomain is string && d.schoolDomain.size() > 0)
            || (d.scope == 'lounge' && d.schoolDomain == null))
        && d.boardId is string && d.boardId.size() > 0
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.body is string && d.body.size() > 0 && d.body.size() <= 5000
        && (d.topic == null || d.topic is string)
        && (d.sourceUrl == null || d.sourceUrl is string)
        && d.createdBy is string;
    }

    // ── コンテンツ投稿キュー（運営のみ・CONTENT-OPS §9） ──
    // 一般利用者は読み書き不可。投稿済みの記録は運営投稿の追跡・一括削除に使うため物理削除禁止。
    // 記事そのものは運営アカウントが通常の掲示板ルール（isAuthor）で投稿する（記事側に運営の印は付けない）。
    match /contentQueue/{itemId} {
      allow read: if isOperator();
      allow create: if isOperator()
        && isValidQueueItem(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isOperator()
        && isValidQueueItem(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }
  }
}
