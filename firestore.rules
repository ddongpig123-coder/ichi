rules_version = '2';

// ============================================================
// ichi Firestore セキュリティルール（拡張版）
//
// 【設計方針】
// - 条件はヘルパー関数に集約し、フェーズ移行時は関数定義のみ変更する。
//   例）成長期に「書き込みは認証ユーザーのみ」へ切り替える場合、
//       canWriteContent() を isSignedIn() && !isAnonymous() に変えるだけ。
// - まだ実装されていないコレクション（courses / reviews / reports /
//   friendRequests / friendships / timetables / lounges）のルールを
//   先行定義しておく。存在しないコレクションへのルールは無害。
// - verified昇格・friendship作成などクライアントに任せると偽装可能な
//   操作は、将来Cloud Functions（Admin SDK）に移す前提でTODOを明記。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── ヘルパー ──────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAnonymous() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // コンテンツ書き込み権限（フェーズ移行スイッチ）
    // 初期    : isSignedIn()                    ← 匿名ゲストも書き込み可
    // 成長期  : isSignedIn() && !isAnonymous()  ← 書き込みのみ認証必須
    function canWriteContent() {
      return isSignedIn();
    }

    // 投稿者本人確認（作成時）
    function isAuthor() {
      return request.resource.data.authorUid == request.auth.uid;
    }

    // 学校所属の確認（1.1 / docs/BOARD-ACCESS.md §3）
    // 学校掲示板は「読みは全員・書きはその学校を選んだ人だけ」。
    // ゲートはログイン有無ではなく users.schoolDomain の一致で張る
    // （匿名認証が常に発行されるので isSignedIn() は常に真になるため）。
    // ・users ドキュメントは AuthContext の ensureUserProfile が必ず作る。
    //   それでも無ければ get() がエラー＝拒否になる（fail closed で正しい）。
    // ・schoolDomain が null（「その他」＝未選択）の人はどの学校掲示板にも書けない。
    //   その人たちの行き先は森（lounges）。画面側で「学校を選択」導線を出す。
    // ・get() はリクエストあたり読み取り1回の課金（§3-5）。usersPublic でも同コスト。
    // 🔑 1.2 で学校メール認証を入れるときは、ここに
    //    && ...data.verificationLevel >= 1 を足すだけでよい（再設計が起きない）。
    function belongsToSchool(schoolDomain) {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.schoolDomain == schoolDomain;
    }

    // ── ユーザープロフィール ─────────────────────────────
    // 本人のみ読み書き可能。パスワードはここに保存しない（Firebase Authが管理）。
    // verificationLevel はクライアントから変更不可（自己昇格の防止）。
    // 昇格はCloud Functions（Microsoft学校アカウント検証後）のみが行う。
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && (!('verificationLevel' in request.resource.data)
            || request.resource.data.verificationLevel == 0);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(['verificationLevel']);
      allow delete: if isOwner(uid);

      // 学期別時間割（先輩時間割公開機能・Phase 2）
      // visibility: "private" | "friends" | "department" | "public"
      match /timetables/{semesterId} {
        // resource == null: その学期の時間割が未作成。友達には「空の時間割」として
        // 見せたいので読み取り(null取得)を許可する（非公開設定との区別のため）。
        allow read: if isOwner(uid)
          || (isSignedIn() && resource == null && isFriendOf(uid))
          || (isSignedIn() && resource != null && resource.data.visibility == 'public')
          || (isSignedIn() && resource != null && resource.data.visibility == 'friends'
              && isFriendOf(uid))
          || (isSignedIn() && resource != null && resource.data.visibility == 'department'
              && sameDepartment(uid));
        allow write: if isOwner(uid);
      }

      // ブロックリスト（本人のみ。相手には見えない）
      match /blocks/{blockedUid} {
        allow read, write: if isOwner(uid);
      }

      // スクラップ（投稿のブックマーク。1.1 S4-5, src/types/scrap.ts）。本人のみ。
      // 投稿のタイトル・板名の写しだけで本文は持たない。
      match /scraps/{scrapId} {
        allow read, write: if isOwner(uid);
      }
    }

    // 友達判定：friendships/{小さいuid_大きいuid} の存在で判定
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function isFriendOf(uid) {
      return exists(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid)));
    }

    // 同一学部判定（読み取り2回発生に注意）
    function sameDepartment(uid) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department
          == get(/databases/$(database)/documents/users/$(uid)).data.department;
    }

    // ── 公開プロフィール（友達検索・表示用の最小情報ミラー） ──
    // users/{uid} 本体は本人のみ読めるため、他ユーザーに見せてよい情報
    // （ニックネーム・写真・学校・学部）だけをここに複製する。
    // GPA等の学業情報は絶対にここへ書かないこと。
    // 🔴 このリストを縮めるとき（2026-11-10 の #98 で学校・学部・入学年度はもう書かない）は
    //    **消す書き込みも affectedKeys に乗る** ことに注意。3つを外すと
    //    ensureUserProfile の後片付け（deleteField）まで拒否され、古い文書が永久に残る。
    //    順番: scripts/strip-public-profile.mjs が 0 件を返す → 旧ストアビルドが
    //    行き渡る → そのあと縮める（縮めるなら「削除だけは許す」を別に書く）。
    //    privacy.test.mjs の「옛 소속 3필드를 지우는 정리 쓰기 → 통과」がこの安全装置。
    function publicProfileKeys() {
      return ['uid', 'nickname', 'photoURL', 'schoolDomain', 'department', 'admissionYear'];
    }

    // 🔑 どのフィールドも「無ければ素通り、あれば形を見る」。merge 書き込みでは
    //    request.resource.data が **合成後の文書全体** になるので、古い文書に
    //    nickname が無くても更新を塞がない形にしてある。
    //    nickname の 20 は src/data/limits.ts の NICKNAME_MAX（isValidAnonymity と同じ値）。
    //
    // 🔴 photoURL を https だけに絞る理由: 今はどの画面も書いていない
    //    （userService.updatePhotoURL に呼び出しが無い）が、値は友達リスト・
    //    招待リンク画面でそのまま <img> / Image の uri になる。任意の URL を
    //    入れられると、そのプロフィールを見た人の IP と UA が URL の持ち主へ渡る
    //    ＝ 追跡ピクセル。プライバシーポリシーの「第三者提供は Google/Firebase のみ」
    //    に反するので、ルール側で止める。
    //    🔑 画像アップロードを入れるときは Storage のホストまで絞るとさらに良い。
    function isValidPublicProfile() {
      let d = request.resource.data;
      return (!('nickname' in d)
               || (d.nickname is string && d.nickname.size() > 0 && d.nickname.size() <= 20))
        && (d.get('photoURL', null) == null
             || (d.photoURL is string && d.photoURL.size() <= 500
                  && d.photoURL.matches('^https://.*$')))
        && (d.get('schoolDomain', null) == null
             || (d.schoolDomain is string && d.schoolDomain.size() <= 64))
        && (d.get('department', null) == null
             || (d.department is string && d.department.size() <= 64))
        && (d.get('admissionYear', null) == null
             || (d.admissionYear is int
                  && d.admissionYear >= 1900 && d.admissionYear <= 2100));
    }

    match /usersPublic/{uid} {
      // 🔴 list（コレクション照会）は禁止。アプリは friendships / emailIndex から uid を
      //    得て doc(usersPublic/{uid}) を1件ずつ読むだけで、照会は一度も使わない
      //    （src/services/userService.ts の publicDoc が唯一の読み口）。開けたままだと
      //    初回起動で誰でも作れる匿名アカウントから **全会員の uid・ニックネーム・
      //    学校・学部の名簿をまるごと** 取れてしまう。読み取り課金も1人で
      //    Spark の日次上限（5万）を焼き切れる（§1-5 = その日アプリが止まる）。
      //    学部で照会していた先輩時間割の名残り（機能は 2026-08-23 に廃止済み）。
      //    emailIndex・operators と同じ「get だけ開ける」形に揃える。
      allow get: if isSignedIn();
      allow list: if false;

      // 🔑 hasOnly(publicProfileKeys()) で「決めた6つ以外は書けない」ようにする。
      //    update 側は affectedKeys にかけるので、昔の版が書いた見知らぬ
      //    フィールドが残っていても（触らなければ）更新は通る。
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(publicProfileKeys())
        && 'nickname' in request.resource.data
        && isValidPublicProfile();
      allow update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(publicProfileKeys())
        && isValidPublicProfile();
      allow delete: if isOwner(uid);
    }

    // ── メール→uid 索引（メールアドレスによる友達検索用） ──
    // 登録はAuthトークンのemailと一致する場合のみ = メール所有者本人だけが
    // 自分の索引を作れる（他人のメールを自分のuidに向ける偽装は不可能）。
    // ドキュメントIDは小文字メールアドレス。
    match /emailIndex/{email} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email == email;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ── 友達申請 ─────────────────────────────────────────
    // { fromUid, toUid, status: "pending"|"accepted"|"rejected", createdAt }
    match /friendRequests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      allow create: if canWriteContent()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      // 状態変更（承認/拒否）は受信者のみ。statusフィールド以外は変更不可。
      allow update: if isSignedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['status']);
      allow delete: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
    }

    // ── 友達関係（確定済み） ──────────────────────────────
    // ドキュメントID: pairId(uid1, uid2)。participants: [uid1, uid2]
    // 以前は片方の操作だけで作れたので、承認なしに友達になって「友達のみ」の時間割を読めてしまった。
    // いまは次の2つのどちらかだけ:
    //   (a) 相手からの申請を自分が承認した … isAcceptedFriendship
    //   (b) 相手の招待リンクを自分が開いた … isInviteFriendship（docs/INVITE-LINK.md §3）
    // ⚠️ 旧アプリは requestId も招待トークンも送らないので、1.1 の OTA が
    //    行き渡ってから配備すること。
    //
    // (a) 申請の承認と同じバッチで作るので getAfter で見る（friendRequestService.acceptFriendRequest）。
    //     requestId が無い・申請が無いと getAfter が null になり .data でエラー＝拒否（fail closed）。
    function isAcceptedFriendship(d) {
      let req = getAfter(/databases/$(database)/documents/friendRequests/$(d.requestId)).data;
      return req.status == 'accepted'
        && req.toUid == request.auth.uid
        && d.participants.size() == 2
        && d.participants.toSet() == [req.fromUid, req.toUid].toSet();
    }

    // 相手のuid。participants が2人・重複なしであることは呼ぶ側で確認済み。
    function otherOf(me, parts) {
      return parts[0] == me ? parts[1] : parts[0];
    }

    // (b) 招待リンク（docs/INVITE-LINK.md）。リンクの k= が「招待した本人」の
    //     users/{uid}.inviteToken と一致するときだけ通す。承認は要らない
    //     （リンクを自分で配ったことが本人の意思表示 — INVITE-LINK §0 の決定）。
    //     users は本人しか読めないが規則の get() は読める。トークンはクライアントに漏れない。
    //
    // 🔑 (a) より先に評価すること。(a) の getAfter は requestId が無いとエラーになり、
    //    招待リンク（requestId を送らない）がそのエラーに巻き込まれるのを避けるため。
    // 🔑 フィールドの有無で分岐するので必ず d.get(…, 既定値) で読む。無いフィールドに
    //    直接触るとエラー＝拒否になり、via を送らない承認フロー(a)まで落ちる。
    function isInviteFriendship(d) {
      let token = d.get('inviteToken', '');
      return d.get('via', '') == 'invite'
        && token is string
        && token.size() >= 16
        && token == get(/databases/$(database)/documents/users/$(otherOf(request.auth.uid, d.participants))).data.get('inviteToken', '');
    }

    match /friendships/{pairDocId} {
      // resource == null は「まだ友達でない」確認のためのget（存在チェック）を許可
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        // 自分と自分の関係を作らせない（participants: [me, me]）。招待リンクは
        // 自分のトークンを自分が知っているので、これが無いと (b) を素通りしてしまう。
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && pairDocId == pairId(request.resource.data.participants[0],
                               request.resource.data.participants[1])
        && (isInviteFriendship(request.resource.data)
            || isAcceptedFriendship(request.resource.data));
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.participants;
    }

    // ── 通報（アプリ審査要件・匿名性維持の前提） ─────────
    // 書き込み専用。他ユーザーの通報履歴は誰にも読ませない。
    // 閲覧・処理は運営（コンソール / Admin SDK）のみ。
    match /reports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── お問い合わせ（アプリ内フォーム。運営がコンソール/Admin SDKで確認） ──
    // 書き込み専用。本人の uid のみ作成可。閲覧・更新・削除はクライアント不可。
    match /inquiries/{inquiryId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── 講義マスターデータ（シラバス由来 + クラウドソーシング） ──
    // 公式クロールデータはAdmin SDKで投入（ルールを経由しない）。
    // クライアントからの登録は未検証（verified: false）のみ許可。
    // verified: true への昇格はCloud Functionsのみ（自作自演の防止）。
    function isValidReviewText() {
      let text = request.resource.data.get('text', null);
      return text == null || (text is string && text.size() <= 1000);
    }

    match /schools/{schoolDomain}/departments/{deptId}/courses/{courseId} {
      allow read: if isSignedIn();
      allow create: if canWriteContent()
        && request.resource.data.verified == false
        && request.resource.data.addedBy == request.auth.uid;
      allow update, delete: if false;

      // クラウドソーシング確認（ユーザー登録講義の実在確認）。
      // ドキュメントID = uid で「1人1回」を構造強制。create/delete のみで
      // courses 本体を update せずに済むため、Blaze(Cloud Functions)不要で
      // 自作自演を防げる。confirms の件数が閾値以上ならクライアントが verified 相当と判定。
      match /confirms/{uid} {
        allow read: if isSignedIn();
        allow create: if canWriteContent()
          && request.auth.uid == uid
          && request.resource.data.uid == uid;
        allow delete: if isOwner(uid);
        allow update: if false;
      }

      // 講義レビュー（Phase 2）
      // ドキュメントID = 投稿者uid（1人1講義1レビューを構造で強制）
      // 構造化評価（rating 1〜5）+ 自由テキスト（言語別）
      match /reviews/{reviewerUid} {
        allow read: if isSignedIn();
        allow create: if canWriteContent()
          && request.auth.uid == reviewerUid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && isValidReviewText();
        allow update: if isOwner(reviewerUid)
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && isValidReviewText();
        allow delete: if isOwner(reviewerUid);
      }
    }

    // ── 掲示板共通ルール（学校掲示板・留学生ラウンジで共用） ──
    // posts / comments / likes の権限パターンを関数化。
    // 文字数の上限は src/data/limits.ts と合わせる（本文 5000 は contentQueue と同じ）。

    // ── 匿名/記名（S4-4, BOARD-ACCESS §8）──────────────────
    // 作成時に固定。更新許可リスト（isAuthorEditOfPost / isAuthorEditOfComment）に
    // 入れていないので、あとから匿名↔記名を切り替えることはできない。
    // 既存文書・まだ更新していないアプリは両フィールドが無い → 匿名として扱う。
    //
    // 匿名なら名前を載せさせない。「匿名で出した」はずの投稿にニックネームが
    // 残っていると、あとで表示を変えただけで本人が割れてしまう。
    //
    // 🔑 記名のときだけ usersPublic.nickname と一致を要求する（匿名側は get を通らない
    //    ＝ 既定の匿名投稿では読み取り課金が増えない）。一致を見る理由は2つ:
    //    ① ニックネーム保存時の禁止語チェック（profile.tsx）を投稿時に迂回できてしまう
    //    ② 投稿ごとに違う名前を名乗れると「記名」＝説明責任の意味が消える
    //    外すなら最後の == get(...) の1行だけ削ればよい（形の検証は残る）。
    // 文字数 20 は src/data/limits.ts の NICKNAME_MAX と合わせる。
    function isValidAnonymity() {
      let d = request.resource.data;
      return (!('anonymous' in d) || d.anonymous is bool)
        && (
          d.get('anonymous', true) == true
            ? d.get('authorNickname', null) == null
            : (d.authorNickname is string
                && d.authorNickname.size() > 0
                && d.authorNickname.size() <= 20
                && d.authorNickname == get(/databases/$(database)/documents/usersPublic/$(request.auth.uid)).data.nickname)
        );
    }

    // 新規投稿: カウンターは 0 から（いいね 9999 の投稿を作らせない）。
    // likeCount / viewCount は学校掲示板の投稿では作成時に無いので「無いか 0」を許す。
    function isValidNewPost() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.body is string && d.body.size() > 0 && d.body.size() <= 5000
        && d.get('likeCount', 0) == 0
        && d.get('commentCount', 0) == 0
        && d.get('viewCount', 0) == 0
        && d.get('deleted', false) == false
        && isValidAnonymity();
    }

    // 検索索引(postIndex)の検証。grams は makePostGrams（src/utils/ngram.ts）が作る。
    function isValidPostIndex() {
      let d = request.resource.data;
      return d.boardId is string && d.boardId.size() > 0 && d.boardId.size() <= 64
        && d.authorUid == request.auth.uid
        && d.grams is list && d.grams.size() > 0 && d.grams.size() <= 400;
    }

    function isValidNewComment() {
      let d = request.resource.data;
      return d.body is string && d.body.size() > 0 && d.body.size() <= 1000
        && d.get('likeCount', 0) == 0
        && d.get('deleted', false) == false
        && isValidAnonymity();
    }

    // カウンターは「ちょうど ±1」だけ。以前は任意の値に書き換えられ、ベスト掲示板を操作できた。
    function changedOnly(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field]);
    }

    function isOneStep(field) {
      let before = resource.data.get(field, 0);
      let after = request.resource.data.get(field, 0);
      return after == before + 1 || after == before - 1;
    }

    // いいね数: +1 は「この書き込みで自分のいいね文書ができる」とき、-1 は「消える」ときだけ。
    // いいね文書とカウンターを同じバッチで書く必要がある（likeToggle.ts）。
    // 1人1回を構造で保証する: 文書を持ったまま +1 を繰り返すことはできない。
    // ⚠️ 旧アプリ（別々に書く）は通らないので、1.1 の OTA が行き渡ってから配備すること。
    //
    // 下限 0（SECURITY-1.1 §7）: マイナスまで下げられない。
    // 🔑 この1行は **カウンター再計算のあと** でなければ入れられなかった。古いデータには
    //    「いいね文書はあるのにカウンターが 0（または負）」という食い違いがあり得て、
    //    その投稿のいいねを外す操作が全部拒否されてしまうため。
    //    2026-11-07 に scripts/recount-counters.mjs を実行し「ずれ 0 件
    //    （投稿 66・コメント 103）」を確認したので、ここで入れる。
    function isValidLikeCountChange(likePath) {
      let before = resource.data.get('likeCount', 0);
      let after = request.resource.data.get('likeCount', 0);
      return changedOnly('likeCount') && (
        (after == before + 1 && !exists(likePath) && existsAfter(likePath))
        || (after == before - 1 && after >= 0 && exists(likePath) && !existsAfter(likePath))
      );
    }

    // 投稿者本人が変えてよい項目。authorUid は法的対応の記録なので絶対に変えさせない
    // （以前は本人なら全項目を書き換えられた）。createdAt・カウンター等も対象外。
    // 本文の長さは変更したときだけ見る（上限導入前の長い投稿でもソフトデリートできるように）。
    function isAuthorEditOfPost() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return resource.data.authorUid == request.auth.uid
        && changed.hasOnly(['title', 'body', 'tag', 'deleted', 'deletedAt', 'resolved', 'bestCommentId'])
        && (!changed.hasAny(['title']) || (d.title is string && d.title.size() > 0 && d.title.size() <= 100))
        && (!changed.hasAny(['body']) || (d.body is string && d.body.size() > 0 && d.body.size() <= 5000))
        // tag は空にする（null）のも許す。文字列なら 30 字まで
        && (!changed.hasAny(['tag']) || d.tag == null || (d.tag is string && d.tag.size() <= 30));
    }

    // コメント数（段階2・docs/SECURITY-1.1.md §7）: 「本当にコメントが増減したか」を見る。
    // 段階1（#80・配備済み）は lastCommentId を任意にして旧アプリも通していたので、
    // コメントを書かずに +1 を繰り返せた（通知の赤丸を永久に鳴らせる・ベスト掲示板の操作）。
    // ⚠️ lastCommentId を必須にするので、1.1 OTA が行き渡ってから配備すること。
    //
    // commentsPath は '…/posts/{postId}/comments' の**文字列**（path() で文書パスを組む）。
    // ルールの関数内では $() 補間が使えないので、呼び出し側で文字列を作って渡している。
    //
    // 🔑 id の文字種を自動id に限定するのが必須。'/' を入れられると comments/{id} 以外の
    //    文書を指せてしまい、「コメントの いいね文書 を作って commentCount を +1」が通る
    //    （id = 'realComment/likes/myUid' で !exists && existsAfter が成立してしまう）。
    // 🔑 exists/get は同じパスなら評価ごとにキャッシュされるので、読み取りは増えない。
    // 🔴 段階2（lastCommentId を必須にして「本当にコメントが増減したか」を見る）は
    //    **別PR に分けた**。ストア版に内蔵のコードが lastCommentId を送らないからだ
    //    （iOS ビルド5 = 2026-11-02 の 6ba8c4b。lastCommentId は 11-06 の c8f8857 で入った）。
    //    OTA は「受け取って **次の起動** から適用」なので、OTA が行き渡っても
    //    **新規インストール直後の初回起動は内蔵コードで動く** → その人はコメントが書けない。
    //    次のストアビルドは 1.2（2027-01 末提出）なので、そこまでこの段階1のまま運用する。
    //    （OTA-2026-11 §0 / SECURITY-1.1 §7）
    function isValidCommentCountChange() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['commentCount', 'lastCommentId'])
        && changed.hasAny(['commentCount'])
        && isOneStep('commentCount')
        && (!changed.hasAny(['lastCommentId']) || request.resource.data.lastCommentId is string);
    }

    function canUpdatePost(likePath) {
      return isSignedIn() && (
        isAuthorEditOfPost() ||
        // いいね数・コメント数・閲覧数のカウンター更新は他ユーザー操作でも発生
        isValidLikeCountChange(likePath) ||
        isValidCommentCountChange() ||
        // 閲覧数は「ちょうど+1」のみ許可する。affectedKeys だけ見ると任意の値に
        // 書き換えられる（水増し・0埋め）ため。既存文書は viewCount 欠落なので get で既定0。
        (
          changedOnly('viewCount') &&
          request.resource.data.viewCount is int &&
          request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1
        )
      );
    }

    // コメント更新権限：本人（ソフトデリート＝deleted等）または
    // likeCount のカウンター更新のみ（他ユーザーのいいねで発生）。
    function isAuthorEditOfComment() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return resource.data.authorUid == request.auth.uid
        && changed.hasOnly(['body', 'deleted', 'deletedAt'])
        && (!changed.hasAny(['body']) || (d.body is string && d.body.size() > 0 && d.body.size() <= 1000));
    }

    function canUpdateComment(likePath) {
      return isSignedIn() && (isAuthorEditOfComment() || isValidLikeCountChange(likePath));
    }

    match /schools/{schoolDomain} {

      // 学校掲示板（学校ごとに分離）
      // 読み取りは全員に開放（コールドスタート優先。他校を覗けること自体が動機になる）。
      // 書き込みだけ所属を見る。締めるときは read 側に belongsToSchool を足せばよい
      // ＝スイッチは残してある（BOARD-ACCESS §3-3）。
      // いいね（likes / likeCount）は所属を見ない：読めるのに押せないと壊れて見えるため。
      match /boards/{boardId}/posts/{postId} {
        allow read: if isSignedIn();
        allow create: if canWriteContent() && isAuthor() && belongsToSchool(schoolDomain) && isValidNewPost();
        allow update: if canUpdatePost(/databases/$(database)/documents/schools/$(schoolDomain)/boards/$(boardId)/posts/$(postId)/likes/$(request.auth.uid));
        // 物理削除は禁止（MODERATION.md §1）: 削除は deleted:true フラグ(=update)で行い、
        // authorUid 等の記録を残す。ハード削除を許すと法的対応の証跡が消えるため。
        allow delete: if false;

        match /comments/{commentId} {
          allow read: if isSignedIn();
          // 대댓글도同じcomments配下（parentIdフィールドで区別、1階層）。
          allow create: if canWriteContent() && isAuthor() && belongsToSchool(schoolDomain) && isValidNewComment();
          allow update: if canUpdateComment(/databases/$(database)/documents/schools/$(schoolDomain)/boards/$(boardId)/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid));
          allow delete: if false; // 物理削除禁止（上と同じ理由）

          // コメント/返信のいいね（ドキュメントID=uid、本人のみ）
          match /likes/{likeUid} {
            allow read: if isSignedIn();
            allow write: if isSignedIn() && request.auth.uid == likeUid;
          }
        }

        // いいね（ドキュメントIDはユーザーのuid）。本人のみ作成・削除可能。
        match /likes/{likeUid} {
          allow read: if isSignedIn();
          allow write: if isSignedIn() && request.auth.uid == likeUid;
        }
      }

      // ── 投稿検索の索引（1.1） ──────────────────────────
      // 投稿本体と同じIDの別文書。本体に grams を持たせると一覧取得のたびに
      // 2-gram を数百個ダウンロードしてしまうため分離した（src/types/postIndex.ts）。
      // 投稿と同じバッチで作る。作成のみ許可し、更新・削除は禁止する
      // ＝索引が本体と食い違わない。論理削除は本体の deleted で判定する。
      // 既存投稿の索引は Admin SDK で補充（scripts/backfill-post-index.mjs）。
      match /postIndex/{postId} {
        allow read: if isSignedIn();
        allow create: if canWriteContent()
          && belongsToSchool(schoolDomain)
          && isValidPostIndex();
        allow update, delete: if false;
      }

      // 学部別・カスタム掲示板のメタ情報
      match /boardMetas/{boardMetaId} {
        allow read: if isSignedIn();
        allow create: if canWriteContent()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 30
          && request.resource.data.get('description', '').size() <= 100;
        allow update, delete: if isSignedIn()
          && resource.data.createdBy == request.auth.uid;
      }

      // 🗑 旧パス schools/{sd}/chats のルールは **削除した**。
      //    1.1 で /chats 最上位へ移し、旧バンドルのために書き込みを開けたままにしていたもの。
      //    1.1 の OTA が行き渡り、scripts/migrate-chats-to-global.mjs が「移した部屋 0」を
      //    連続で返すようになったので閉じた（手順は docs/OTA-2026-11.md §5）。
      //
      // 🔴 ここに chats のルールを復活させないこと。学校スコープに戻すと、森から他校ユーザーに
      //    送ったメッセージが相手に永久に届かない（送信者の学校の下に部屋ができるのに、受信者は
      //    自分の学校の下だけを購読するため）。メッセージは下の「全国チャット」= /chats だけ。
      //    旧パスの文書自体は消していない（migrate は複写で、Admin SDK からは読める。
      //    取りこぼしが見つかったときに復旧できるようにするため）。
    }

    // ── 個別チャット（メッセージ。全国スコープ・1.1） ──────
    // 学校の下から最上位へ移した。理由は上の DEPRECATED ブロックのコメント参照。
    // 権限は参加者（participants）ベースなので学校とは無関係に成立する。
    // schoolDomain を見ないので、学校未選択（その他）のユーザーもメッセージを使える。
    match /chats/{chatId} {
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow delete: if false; // 物理削除禁止（MODERATION.md §1）

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false; // 送信済みメッセージは改変・物理削除不可
      }
    }

    // 森の投稿検索の索引（学校掲示板と同じ構造。所属は見ない＝森と同じ条件）。
    match /lounges/{loungeId}/postIndex/{postId} {
      allow read: if isSignedIn();
      allow create: if canWriteContent() && isValidPostIndex();
      allow update, delete: if false;
    }

    // ── 留学生ラウンジ（全国単位の掲示板・Phase 1） ────────
    // 学校掲示板と同じ権限パターン。学校選択のみで参加可能（低い参入障壁）。
    match /lounges/{loungeId}/posts/{postId} {
      allow read: if isSignedIn();
      allow create: if canWriteContent() && isAuthor() && isValidNewPost();
      allow update: if canUpdatePost(/databases/$(database)/documents/lounges/$(loungeId)/posts/$(postId)/likes/$(request.auth.uid));
      allow delete: if false; // 物理削除禁止（MODERATION.md §1、学校掲示板と同じ）

      match /comments/{commentId} {
        allow read: if isSignedIn();
        // 대댓글도同じcomments配下（parentIdフィールドで区別、1階層）。
        allow create: if canWriteContent() && isAuthor() && isValidNewComment();
        allow update: if canUpdateComment(/databases/$(database)/documents/lounges/$(loungeId)/posts/$(postId)/comments/$(commentId)/likes/$(request.auth.uid));
        allow delete: if false; // 物理削除禁止

        // コメント/返信のいいね（ドキュメントID=uid、本人のみ）
        match /likes/{likeUid} {
          allow read: if isSignedIn();
          allow write: if isSignedIn() && request.auth.uid == likeUid;
        }
      }

      match /likes/{likeUid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == likeUid;
      }
    }

    // ── 運営アカウント名簿（コンテンツ自動投稿・CONTENT-OPS §9） ──
    // 登録・削除は Firebase コンソールのみ（クライアントからの自己登録を防ぐ）。
    // 本人は「自分が運営か」だけ確認できる（承認画面の表示判定用）。一覧は誰にも見せない。
    match /operators/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow write: if false;
    }

    function isOperator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/operators/$(request.auth.uid));
    }

    // src/types/contentQueue.ts の ContentQueueItem と1:1（postedAt / postedPath は投稿後の付記なので検証しない）
    function isValidQueueItem(d) {
      return d.status in ['draft', 'approved', 'rejected', 'posted']
        && d.source in ['manual', 'ai']
        && ((d.scope == 'school' && d.schoolDomain is string && d.schoolDomain.size() > 0)
            || (d.scope == 'lounge' && d.schoolDomain == null))
        && d.boardId is string && d.boardId.size() > 0
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.body is string && d.body.size() > 0 && d.body.size() <= 5000
        && (d.topic == null || d.topic is string)
        && (d.sourceUrl == null || d.sourceUrl is string)
        && d.createdBy is string;
    }

    // ── コンテンツ投稿キュー（運営のみ・CONTENT-OPS §9） ──
    // 一般利用者は読み書き不可。投稿済みの記録は運営投稿の追跡・一括削除に使うため物理削除禁止。
    // 記事そのものは運営アカウントが通常の掲示板ルール（isAuthor）で投稿する（記事側に運営の印は付けない）。
    match /contentQueue/{itemId} {
      allow read: if isOperator();
      allow create: if isOperator()
        && isValidQueueItem(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isOperator()
        && isValidQueueItem(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }
  }
}
