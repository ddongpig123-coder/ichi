{
  "expo": {
    "name": "大学の森",
    "slug": "uni-community",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "uni-community",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "jp.timetable.app",
      "associatedDomains": ["applinks:ichi-6b8f7.web.app"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ja"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "jp.timetable.app",
      "blockedPermissions": ["com.google.android.gms.permission.AD_ID", "android.permission.CAMERA"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "ichi-6b8f7.web.app", "pathPrefix": "/add-friend" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "locales": {
      "ja": "./locales/ja.json",
      "ko": "./locales/ko.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "時間割のスクリーンショットを選んで授業を読み取るために、写真へのアクセスを使います。",
          "cameraPermission": "写真を撮って時間割を読み込む場合に、カメラを使います。",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#F5F7FA",
          "dark": {
            "image": "./assets/splash-logo.png",
            "backgroundColor": "#131417"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2F6AD9"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d57937dd-576b-4174-a2c0-96e918a7bca9"
      }
    },
    "owner": "qopdri",
    "updates": {
      "url": "https://u.expo.dev/d57937dd-576b-4174-a2c0-96e918a7bca9"
    }
  }
}
